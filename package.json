{
	"name": "@dacodedbeat/with-defer-js",
	"version": "1.0.0",
	"description": "A simple and lightweight JavaScript library for scheduling deferred function callbacks to execute after a function, like Golang.",
	"keywords": [
		"async",
		"cancellation",
		"cleanup",
		"defer",
		"error-handling",
		"golang",
		"javascript",
		"promise",
		"timeout"
	],
	"license": "MPL-2.0",
	"author": "Arun Philip <dacodedbeat@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/DAcodedBEAT/with-defer-js.git"
	},
	"files": [
		"src/with-defer.js",
		"src/with-defer.d.ts",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "src/with-defer.js",
	"exports": {
		".": {
			"import": "./src/with-defer.js",
			"types": "./src/with-defer.d.ts"
		}
	},
	"scripts": {
		"test": "vitest",
		"test:run": "vitest --run --reporter=verbose",
		"test:coverage": "vitest --coverage",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"fmt": "oxfmt --check .",
		"fmt:fix": "oxfmt .",
		"check": "npm run lint && npm run fmt",
		"check:fix": "npm run lint:fix && npm run fmt:fix",
		"typecheck": "tsc --noEmit",
		"generate:types": "tsc",
		"prepack": "npm run check && npm run typecheck && npm run test:run && npm run generate:types"
	},
	"devDependencies": {
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"oxfmt": "*",
		"oxlint": "*",
		"semantic-release": "^25.0.9",
		"typescript": "^6.0.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=16.0.0"
	}
}
