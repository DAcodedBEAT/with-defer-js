{
	"name": "@dacodedbeat/with-defer-js",
	"version": "1.1.0",
	"description": "A simple and lightweight JavaScript library for scheduling deferred function callbacks to execute after a function, like Golang.",
	"keywords": [
		"async",
		"cancellation",
		"cleanup",
		"defer",
		"error-handling",
		"golang",
		"javascript",
		"promise",
		"timeout"
	],
	"license": "MPL-2.0",
	"author": "Arun Philip <dacodedbeat@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/DAcodedBEAT/with-defer-js.git"
	},
	"files": [
		"src/with-defer.js",
		"src/with-defer.d.ts",
		"dist/cjs/with-defer.js",
		"dist/cjs/package.json",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "dist/cjs/with-defer.js",
	"exports": {
		".": {
			"types": "./src/with-defer.d.ts",
			"import": "./src/with-defer.js",
			"require": "./dist/cjs/with-defer.js",
			"default": "./src/with-defer.js"
		}
	},
	"scripts": {
		"test": "vitest",
		"test:run": "vitest --run --reporter=verbose",
		"test:coverage": "vitest --coverage",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"fmt": "oxfmt --check .",
		"fmt:fix": "oxfmt .",
		"check": "npm run lint && npm run fmt",
		"check:fix": "npm run lint:fix && npm run fmt:fix",
		"typecheck": "tsc --noEmit",
		"generate:types": "tsc && oxfmt src/with-defer.d.ts",
		"build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
		"build": "npm run generate:types && npm run build:cjs",
		"prepack": "npm run check && npm run typecheck && npm run test:run && npm run build"
	},
	"devDependencies": {
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@vitest/coverage-v8": "^4.1.11",
		"oxfmt": "*",
		"oxlint": "*",
		"semantic-release": "^25.0.9",
		"typescript": "^6.0.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": "^20.0.0 || ^22.0.0 || >=24.0.0"
	}
}
